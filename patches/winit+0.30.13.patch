+/// Map `smb://[user@]host/share/path` → `/run/user/$UID/kio-fuse-*/smb/host/share/path`.
+///
+/// Plasma Dolphin drags from an SMB view put `smb://` on the XDnD uri-list; stock winit rejected
+/// those and the drop never reached egui. KIO Fuse exposes the same tree under `kio-fuse-*`.
+fn resolve_smb_uri_to_kio_fuse(uri: &str) -> Result<PathBuf, DndDataParseError> {
+    let rest = uri
+        .strip_prefix("smb://")
+        .ok_or_else(|| DndDataParseError::UnexpectedProtocol(uri.to_owned()))?;
+    let rest = percent_decode(rest.as_bytes()).decode_utf8()?.into_owned();
+    // Drop userinfo (`user:pass@host/...`).
+    let hostpath = rest.split_once('@').map(|(_, hp)| hp).unwrap_or(rest.as_str());
+    let (host, rel) = hostpath
+        .split_once('/')
+        .ok_or_else(|| DndDataParseError::UnexpectedProtocol(uri.to_owned()))?;
+    if host.is_empty() {
+        return Err(DndDataParseError::UnexpectedProtocol(uri.to_owned()));
+    }
+    let rel = rel.trim_start_matches('/');
+
+    let uid = unsafe { libc::getuid() };
+    let run_user = PathBuf::from(format!("/run/user/{uid}"));
+    let mut fallback: Option<PathBuf> = None;
+    if let Ok(entries) = std::fs::read_dir(&run_user) {
+        for ent in entries.flatten() {
+            let name = ent.file_name();
+            let Some(name) = name.to_str() else {
+                continue;
+            };
+            if !name.starts_with("kio-fuse-") {
+                continue;
+            }
+            let mut candidate = ent.path();
+            candidate.push("smb");
+            candidate.push(host);
+            for seg in rel.split('/').filter(|s| !s.is_empty()) {
+                candidate.push(seg);
+            }
+            // Prefer a path that already exists (live mount); otherwise keep the first candidate.
+            if candidate.exists() {
+                return Ok(candidate);
+            }
+            if fallback.is_none() {
+                fallback = Some(candidate);
+            }
+        }
+    }
+    fallback.ok_or_else(|| {
+        DndDataParseError::UnresolvablePath(io::Error::new(
+            io::ErrorKind::NotFound,
+            format!("no kio-fuse mount for {uri}"),
+        ))
+    })
+}
